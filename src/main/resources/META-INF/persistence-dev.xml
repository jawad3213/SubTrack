<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_1.xsd"
             version="3.1">
    
    <!-- Development persistence unit - uses validate to catch entity-schema mismatches -->
    <persistence-unit name="subtrackPU" transaction-type="JTA">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <jta-data-source>java:global/SubtrackDS</jta-data-source>
        
        <!-- Entity Classes -->
        <class>com.subtrack.entity.Client</class>
        <class>com.subtrack.entity.Subscription</class>
        <class>com.subtrack.entity.PaymentHistory</class>
        <class>com.subtrack.entity.Category</class>
        <class>com.subtrack.entity.AlertRule</class>
        <class>com.subtrack.entity.EmailIntegration</class>
        <class>com.subtrack.entity.Invoice</class>
        <class>com.subtrack.entity.ExchangeRate</class>
        <class>com.subtrack.entity.SaaSService</class>
        <class>com.subtrack.entity.SystemConfig</class>
        <class>com.subtrack.entity.SystemLog</class>
        <class>com.subtrack.entity.NotificationLog</class>
        
        <properties>
            <!-- Hibernate Configuration - Development Mode -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>
            <!-- validate ensures entities match schema (won't create/update) -->
            <property name="hibernate.hbm2ddl.auto" value="validate"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
            <property name="hibernate.use_sql_comments" value="true"/>
            
            <!-- Connection Pool -->
            <property name="hibernate.connection.pool_size" value="5"/>
            
            <!-- Second Level Cache disabled -->
            <property name="hibernate.cache.use_second_level_cache" value="false"/>
            
            <!-- Statistics for performance tuning -->
            <property name="hibernate.generate_statistics" value="true"/>
        </properties>
    </persistence-unit>
    
</persistence>