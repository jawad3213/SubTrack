<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">
    
    <display-name>SubTrack - SaaS Subscription Management</display-name>

    <!-- Credentials come from environment variables, or from system properties loaded from .env
         (see the "dotenv" profile in pom.xml). WildFly only resolves ${...}
         here when spec-descriptor-property-replacement is enabled (see wildfly/enable-property-replacement.cli). -->
    <data-source>
        <name>java:global/SubtrackDS</name>
        <class-name>org.postgresql.ds.PGSimpleDataSource</class-name>
        <url>${env.SUBTRACK_DB_URL,SUBTRACK_DB_URL:jdbc:postgresql://localhost:5432/subtrack}</url>
        <user>${env.SUBTRACK_DB_USER,SUBTRACK_DB_USER:postgres}</user>
        <password>${env.SUBTRACK_DB_PASSWORD,SUBTRACK_DB_PASSWORD}</password>
    </data-source>
    
    <!-- Jakarta Faces Configuration -->
    <servlet>
        <servlet-name>Faces Servlet</servlet-name>
        <servlet-class>jakarta.faces.webapp.FacesServlet</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>Faces Servlet</servlet-name>
        <url-pattern>*.xhtml</url-pattern>
    </servlet-mapping>
    
    <!-- Welcome Files -->
    <welcome-file-list>
        <welcome-file>index.xhtml</welcome-file>
    </welcome-file-list>
    
    <!-- Session Configuration -->
    <!-- Session cookie is HTTPS-only by default. For plain-HTTP local runs (other than localhost),
         set SUBTRACK_SECURE_COOKIES=false. -->
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
            <secure>${env.SUBTRACK_SECURE_COOKIES,SUBTRACK_SECURE_COOKIES:true}</secure>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>
    
    <!-- JSF State Saving -->
    <context-param>
        <param-name>jakarta.faces.STATE_SAVING_METHOD</param-name>
        <param-value>server</param-value>
    </context-param>
    
    <!-- Project Stage: Production unless SUBTRACK_PROJECT_STAGE=Development is set -->
    <context-param>
        <param-name>jakarta.faces.PROJECT_STAGE</param-name>
        <param-value>${env.SUBTRACK_PROJECT_STAGE,SUBTRACK_PROJECT_STAGE:Production}</param-value>
    </context-param>
    
    <!-- Default Resource Bundle -->
    <context-param>
        <param-name>jakarta.faces.DEFAULT_SUFFIX</param-name>
        <param-value>.xhtml</param-value>
    </context-param>
    
    <!-- Character Encoding -->
    <filter>
        <filter-name>CharacterEncodingFilter</filter-name>
        <filter-class>com.subtrack.filter.CharacterEncodingFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>CharacterEncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>
    
    <!-- Error Pages -->
    <error-page>
        <error-code>404</error-code>
        <location>/error/404.xhtml</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/error/500.xhtml</location>
    </error-page>
</web-app>
