# Copy to .env (git-ignored) or export these as real environment variables.
# wildfly:run / wildfly:dev (IntelliJ or terminal) load .env automatically as server
# system properties via the "dotenv" Maven profile; real environment variables win.

SUBTRACK_DB_URL=jdbc:postgresql://localhost:5432/subtrack
SUBTRACK_DB_USER=postgres
SUBTRACK_DB_PASSWORD=

# Local development overrides (defaults are production-safe: Production / true / false)
# SUBTRACK_PROJECT_STAGE=Development
# SUBTRACK_SECURE_COOKIES=false
# SUBTRACK_SHOW_SQL=true

# Initial admin account, created only when no ADMIN user exists yet.
SUBTRACK_ADMIN_EMAIL=
SUBTRACK_ADMIN_PASSWORD=

# Public URL used in password-reset emails, e.g. https://subtrack.example.com/subtrack
APP_BASE_URL=

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GEMINI_API_KEY=
